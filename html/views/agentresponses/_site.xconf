<page>
	<property name="fallbackdirectory">../default</property>

	<property name="showaddnew">false</property>

	<property name="hitsname">hits</property>

	<property name="searchhomename">agentresponse</property>

	<property name="searchhome">/${applicationid}/views/modules/${module}/results/agentresponse</property>

	<path-action name="TranslationModule.loadTranslationManager" />

	<path-action bean="jsonUtil" name="PageValue.loadPageVariable" allowduplicates="true"/>

	<generator name="velocityGenerator" mimetypes="text/html"/>
	<generator name="velocityGenerator" mimetypes="text/json"/>
	<generator name="velocityGenerator" mimetypes="application/json"/>

</page>