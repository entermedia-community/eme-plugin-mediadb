{
	"messageplain": "[[Welcome!]] [[Here are some things I can help you with]]#ifnotnull( $menulabel ) [[in]] #jrender( "$!menulabel.text" )#end.",
	"ops": [
		{ "insert": "[[Welcome!]]" },
		{ "attributes": { "header": 3 }, "insert": "\n" },
		{ "insert": "[[Here are some things I can help you with]]#ifnotnull( $menulabel ) [[in]] #end" },
		#ifnotnull( $menulabel )
		{ "attributes": { "bold": true }, "insert": "#jrender( "$!menulabel.text" )" },
		#end
		{ "insert": ":\n" },
		#if( $menuscenarios && !$menuscenarios.isEmpty() )
		#foreach( $scenario in $menuscenarios )
		{
			"attributes": {
				"link": "$applink/views/modules/${agentcontext.entitymoduleid}/editors/entitychat/chatterbox/changescenario.html",
				"class": "ajax",
				"data-targetdiv": "changescenario",
				"data-channel": "$!{channel.getId()}",
				"data-currentscenario": "$scenario.id",
				"data-functionname": "${scenario.id}_confirm",
				"data-oemaxlevel": "1"
			},
			"insert": "#jtext( $scenario )"
		},
		#ifnotnull( $scenario.markdowncontent )
		{ "insert": ": #jrender( "$scenario.markdowncontent" )" },
		#end
		{ "attributes": { "list": "bullet" }, "insert": "\n" },
		#end
		#else
		{ "insert": "[[No chat options are available yet.]]\n" },
		#end
		{ "insert": "\n" }
	],
	"append": "<div id='changescenario'></div>"
}
