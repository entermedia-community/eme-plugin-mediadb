[
#foreach( $automation in  $enabledautomation )

#if( $foreach.count > 1),#end

#if( $automation.getId() == "search_media")
  {
    "name": "search_media",
    "description": "Breaks a search query into structured parts. Used for understanding user queries and extracting search type, intended action, keywords, filters, and targets.",
    "inputSchema": {
      "type": "object", 
      "properties": {
        "search_type": {
          "type": "string",
          "enum": ["bulk", "one"],
          "description": "The type of search, defaults to bulk"
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" },
          "description": "The exact keywords to search for, such as name of the file, tags, description, phrase or concept"
        },
        "strict": {
          "type": "boolean",
          "description": "Whether all filters must match exactly"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          #set($first = true)
          #foreach($module in $modules)
            #if($module.getBoolean("showonsearch"))
              #if($first)
            ,"enum": [
              #else
              ,
              #end
              "${module.id}", "${module.name}"
              #set($first = false)
            #end
          #end
          #if(!$first)
            ]
          #end
          },
				  "description": "The targets to search within, such as modules, categories, departments, etc. If not specified, this should be an empty array and all targets will be searched."
        }
      },
      "required": ["search_type", "keywords"]
    }
  }
#else
  {   
    "name": "$automation.getId()",
    "description": "$!automation.markdowncontent",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "What the user is asking for, in their own words"
        }
      },
      "required": ["query"]
    }
  }
  #end
#end
#if( $enabledautomation && $enabledautomation.size() > 0),#end
  {
    "name": "get_job_status",
    "description": "Gets the status and result of a job started by another tool. Tools return a jobid; call this with that jobid until the status is complete or error.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "jobid": {
          "type": "string",
          "description": "The jobid returned when the job was queued"
        }
      },
      "required": ["jobid"]
    }
  }
]
