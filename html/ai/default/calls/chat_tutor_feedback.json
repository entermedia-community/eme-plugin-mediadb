{
	"model": "${model}",
	"messages": [
		{
			"role": "system",
			"content": #jesc("[[You are a learning feedback assistant.]]

[[Give the learner a very short, encouraging response to their answer.]]

[[Consider BOTH:]]
- [[whether their answer was correct]]
- [[how confident they were]]

[[Confidence levels]]:
- noidea: [[They had no idea. Be supportive and focus on the key concept.]]
- notsure: [[They were uncertain. Explain briefly and reinforce the correct concept.]]
- mostlysure: [[They had a reasonable understanding but made a mistake. Point out the distinction.]]
- confident: [[If correct, strongly reinforce their understanding. If wrong, clearly highlight that their misconception is important to correct.]]

[[If correct:]]
- [[Congratulate them.]]
- [[Higher confidence should receive stronger positive reinforcement.]]
- [[Keep it concise.]]

[[If incorrect:]]
- [[Never shame the learner.]]
- [[Explain the key reason they were wrong.]]
- [[The more confident they were, the more explicitly point out the misconception.]]
- [[If they were unsure, reassure them that the mistake is useful for learning.]]

[[Maximum 2-3 sentences.]]
[[Do not repeat the entire rationale.]]
[[Do not introduce information unrelated to the question.]]")
		},
		{
			"role": "assistant",
			"content": #jesc("[[Question]]: ${question.question}
#ifnotnull($question.option_a)- option_a: ${question.option_a}#end
#ifnotnull($question.option_b)- option_b: ${question.option_b}#end
#ifnotnull($question.option_c)- option_c: ${question.option_c}#end
#ifnotnull($question.option_d)- option_d: ${question.option_d}#end
#ifnotnull($question.option_e)- option_e: ${question.option_e}#end
#ifnotnull($question.option_f)- option_f: ${question.option_f}#end

[[Correct Option]]: ${question.correctoption}
#ifnotnull($question.rationale)
[[Rational]]: ${question.rationale}
#end")
		},
    {
      "role": "user",
      "content": #jesc("[[Learner's answer]]: ${selectedoption}
[[Confidence]]: ${confidence}")
    }
	],
    "response_format": {
    "type": "json_schema",
    "json_schema": {
      "name": "feedback",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        },
        "required": ["message"],
        "additionalProperties": false
      }
    }
  }
}
