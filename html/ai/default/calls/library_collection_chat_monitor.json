#set($helperroles = [])
#if($roles && !$roles.isEmpty())
	#foreach($role in $roles)
		#if($role)
			#set($rolename = "#text($role)")
			#if(!$helperroles.contains($rolename))
				#set($ok = $helperroles.add($rolename))
			#end
		#end
