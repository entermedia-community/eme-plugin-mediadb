{
	"model": "${model}",
	"messages": [
		{
			"role": "system",
			"content": #jesc("[[You are a helpful assistant quietly monitoring a group chat between several team members. Read the message history and decide which of the available menu options the team is most likely to need, so we can offer that menu to the group at the right moment.]]

			[[Available menu options:]]
#foreach($scenario in $menuscenarios)
			- $scenario.id: #text($scenario)#if($scenario.markdowncontent) - $scenario.markdowncontent#end

#end
			- none: [[The team is only chatting, or nothing on the menu fits.]]

			[[Rank up to three of the most likely menu options, most likely first, each with a likelihood from 0 to 100 and a short reason based on what was said. Focus on the most recent messages, but use earlier messages for context. Only rank options that match what the team is discussing; use none when nothing fits.]]

			[[Choose the helper role that is best suited to help the team with the top option.]]

			[[The confirmation is a short, friendly question offering the top option to the group, addressing the team directly and mentioning the specific subject (for example: Would you like help searching for images of cars?).]]

			[[The wait_minutes is how long to wait, from 0 to 5 minutes, before showing the menu in the group chat, giving the team a chance to finish their thought or answer each other. Use 0 when the need is clear and complete. Use a longer wait when the conversation is still going, details are missing, or another team member is likely to respond. Use 5 when the top option is none.]]")
		}
#foreach($message in $channelchathistory)
		,
	#if($message.user == "agent")
		{
			"role": "assistant",
			"content": #jesc($!message.messageplain)
		}
	#else
		{
			"role": "user",
			"content": #jesc("$!message.user: $!message.message")
		}
	#end
#end
	],
	"tools": [
		{
			"type": "function",
			"function": {
				"name": "recommend_menu",
				"description": "Recommend which menu options to offer the group chat, which helper role should offer them, and how long to wait before offering.",
				"parameters": {
					"type": "object",
					"properties": {
						"scenarios": {
							"type": "array",
							"description": "Up to three of the most likely menu options, most likely first.",
							"maxItems": 3,
							"items": {
								"type": "object",
								"properties": {
									"scenarioid": {
										"type": "string",
										"description": "The id of the menu option.",
										"enum": [#foreach($scenario in $menuscenarios)"$scenario.id", #end"none"]
									},
									"likelihood": {
										"type": "integer",
										"description": "How likely, from 0 to 100, it is that the team needs this option right now."
									},
									"reason": {
										"type": "string",
										"description": "A short reason based on what was said in the chat."
									}
								},
								"required": ["scenarioid", "likelihood", "reason"]
							}
						},
						"helperrole": {
							"type": "string",
							"description": "The helper role best suited to help the team with the top option.",
							"enum": [#foreach($role in $helperroles)#jesc($role)#if($foreach.hasNext), #end#end]
						},
						"instruction": {
							"type": "string",
							"description": "A short summary of what the team needs, written as a command. Example: Search the database for invoices from last month."
						},
						"context": {
							"type": "string",
							"description": "Names, dates, amounts, record types and other details from the chat needed to complete the request. Leave empty if none."
						},
						"confirmation": {
							"type": "string",
							"description": "A short, friendly question offering the top option to the group. Example: Would you like help searching for images of cars?"
						},
						"wait_minutes": {
							"type": "integer",
							"description": "How many minutes to wait, from 0 to 5, before showing the menu in the group chat.",
							"enum": [0, 1, 2, 3, 4, 5]
						}
					},
					"required": ["scenarios", "helperrole", "instruction", "context", "confirmation", "wait_minutes"]
				}
			}
		}
	],
	"tool_choice": "required"
}
