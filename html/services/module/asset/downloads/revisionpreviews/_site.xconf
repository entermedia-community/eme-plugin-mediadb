<?xml version="1.0" encoding="UTF-8"?>

<page>

	<property name="assetrootfolder">/${applicationid}/services/module/asset/downloads/revisionpreviews</property>
	<property name="exactsourcepath">true</property>
	<property name="skipheader">true</property>
	
	<path-action name="Admin.allowViewing" alltypes="true" forbid="true"/>
	
	<permission name="view">
		<or>
			<action name="AssetControlModule.loadDownloadPermission" />
			<userprofile property="downloadall" equals="true" /> 
			<action name="OrderModule.canViewAsset" />
		</or>
	</permission>
	
	<generator name="originalPreviewDownloadGenerator"/>
		
</page>