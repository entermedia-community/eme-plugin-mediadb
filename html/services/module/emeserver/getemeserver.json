{
  "response": {
    "status": "ok"#if($user),
    "userid": "$user.id"#end
  },
  #if($emeserver)
  "emeserver": {
    "id": #jesc($emeserver.id),
    "name": #jesc($emeserver.name),
    "subtitle": #jesc($emeserver.subtitle),
    "serverdescription": #jesc($emeserver.serverdescription),
    #set($cat = $mediaarchive.getCachedData("servercategory", $emeserver.category))
    "category": {
      #ifnotnull($cat)
      "id": #jesc($cat.id),
      "name": #jesc($cat.name)
      #end
      #ifnull($cat)
      "id": #jesc($emeserver.category),
      "name": #jesc($emeserver.category)
      #end
    },
    "primarycolor": #jesc($emeserver.primarycolor),
    "secondarycolor": #jesc($emeserver.secondarycolor),
    "membercount": #if($emeserver.membercount)$emeserver.membercount#else 0#end,
    "servicesoffered": #jesc($emeserver.servicesoffered),
    "avatarurl": #jesc($emeserver.avatarurl),
    "statuscolor": #jesc($emeserver.statuscolor),
    "servermediadburl": #jesc($emeserver.servermediadburl),
    "serverfunction": #jesc($emeserver.serverfunction),
    "joined": $joined
  }
  #else
  "emeserver": null
  #end
}
