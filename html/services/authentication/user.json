#set($emeservers = $mediaarchive.query("emeserver").all().search())

{
	#ifnotnull($user)
	"response": {
		"status": "ok",
		"userid": "$user.id"
	},
	"user": { 
		"id" : "$user.id",
		"firstname": "$!user.firstName",
		"lastname" : "$!user.lastName",
		"email" : "$!user.email",
		"screenname" : "$!user.getScreenName()"
		#set($assetportrait = "$!siteroot$mediaarchive.asLinkToPreview($userprofile.assetportrait, 'image200x200')")
		#ifnotnull($assetportrait),
		"assetportrait" : "$assetportrait"
		#end
	},
	"servers": [
		#foreach($emeserver in $emeservers)
			#if($foreach.count > 1),#end
		{
			"id": #jesc($emeserver.id),
			"name": #jesc($emeserver.name),
			"mediadbroot": #jesc($emeserver.mediadbroot),
			"iconasset": #jesc($emeserver.iconasset)
		}
		#end
	]
	#end

	#ifnull($user)
	"response": {
		"status": "error",
		"userid": null
	}
	#end
}
