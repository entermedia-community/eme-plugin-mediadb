#set($emeservers = $mediaarchive.query("emeserver").all().search())

{
	#ifnotnull($user)
	"response": {
		"status": "ok",
		"userid": "$user.id"
	},
	"user": { 
		"id" : "$user.id",
		"firstname": "$!user.firstName",
		"lastname" : "$!user.lastName",
		"email" : "$!user.email",
		"screenname" : "$!user.getScreenName()",
		"emeprofileid" : #jesc($myemeprofile.id),
		"displayname" : #jesc($myemeprofile.displayname),
		"name" : #jesc($myemeprofile.name)
		#set($portraitid = $myemeprofile.primarymedia)
		#if($portraitid)
		#set($portraitasset = $mediaarchive.getAsset($portraitid))
		#end
		#if($portraitasset)
		,"assetportrait" : "$!siteroot$mediaarchive.asLinkToPreview($portraitasset, 'image200x200')"
		,"assetportraitid" : "$portraitasset.id"
		#if($portraitasset.previewstatus == "2")
		,"assetportraitstatus" : "ready"
		#elseif($portraitasset.importstatus == "error")
		,"assetportraitstatus" : "error"
		#else
		,"assetportraitstatus" : "pending"
		#end
		#end
		#ifnotnull($userprofile.dataconsent),
		"dataconsent" : "$userprofile.dataconsent"
		#end
	},
	"servers": [
		#foreach($emeserver in $emeservers)
			#if($foreach.count > 1),#end
		{
			"id": #jesc($emeserver.id),
			"name": #jesc($emeserver.name),
			"mediadbroot": #jesc($emeserver.mediadbroot),
			"iconasset": #jesc($emeserver.iconasset)
		}
		#end
	]
	#end

	#ifnull($user)
	"response": {
		"status": "error",
		"userid": null
	}
	#end
}
